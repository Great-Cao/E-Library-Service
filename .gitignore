# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*

# Maven build output
target/

# IDE files
.idea/
*.iml
.vscode/
.classpath
.project
.settings/

# Runtime SQLite databases (seeded on startup, never committed)
data/*.db
data/*.db-journal
data/*.db-wal
data/*.db-shm

# Local secrets / overrides
application-local.yml
.env

# Frontend
frontend/node_modules/
frontend/dist/
# Generated by the optional single-package build (npm run build:single).
src/main/resources/static/

# Personal interview preparation — deliberately not published with the assignment.
notes/

data/
